pipeline {
  agent any

  environment {
    SERVICE_BRANCH = 'payment'
    SERVICE_DIR = 'service'
    IMAGE_NAME  = 'my-dockerhub/payment:latest'
    SONAR_KEY   = 'payment'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Checkout service code') {
      steps {
        script {
          env.REPO_URL = scm.userRemoteConfigs[0].url
        }
        dir("${env.SERVICE_DIR}") {
          checkout([$class: 'GitSCM', branches: [[name: "*/${env.SERVICE_BRANCH}"]], userRemoteConfigs: [[url: env.REPO_URL]]])
        }
      }
    }

    stage('Maven unit tests') {
      steps {
        dir("${env.SERVICE_DIR}") {
          sh 'mvn -B -q test'
        }
      }
    }

    stage('SonarQube analysis') {
      steps {
        dir("${env.SERVICE_DIR}") {
          withSonarQubeEnv('SonarQube') {
            sh 'mvn -B -q sonar:sonar -Dsonar.projectKey=${SONAR_KEY} -Dsonar.token=$SONAR_AUTH_TOKEN'
          }
        }
      }
    }

    stage('Quality Gate') {
      steps {
        timeout(time: 10, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: true
        }
      }
    }

    stage('Docker build and tag') {
      steps {
        dir("${env.SERVICE_DIR}") {
          sh 'cp "$WORKSPACE/payment/Dockerfile" Dockerfile'
          sh "docker build -t ${env.IMAGE_NAME} -f Dockerfile ."
        }
      }
    }
  }
}
