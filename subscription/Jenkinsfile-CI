pipeline {
  agent any

  environment {
    SERVICE_DIR = 'subscription'
    IMAGE_NAME  = 'my-dockerhub/subscription:latest'
    SONAR_KEY   = 'subscription'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Maven unit tests') {
      steps {
        dir("${env.SERVICE_DIR}") {
          sh 'docker run --rm -v "$WORKSPACE:/ws" -v "$HOME/.m2:/root/.m2" -w "/ws/${SERVICE_DIR}" maven:3.9.9-eclipse-temurin-17 mvn -B -q test'
        }
      }
    }

    stage('SonarQube analysis') {
      steps {
        dir("${env.SERVICE_DIR}") {
          withSonarQubeEnv('SonarQube') {
            sh 'docker run --rm -v "$WORKSPACE:/ws" -v "$HOME/.m2:/root/.m2" -w "/ws/${SERVICE_DIR}" -e SONAR_HOST_URL -e SONAR_AUTH_TOKEN maven:3.9.9-eclipse-temurin-17 mvn -B -q sonar:sonar -Dsonar.projectKey=${SONAR_KEY}'
          }
        }
      }
    }

    stage('Quality Gate') {
      steps {
        timeout(time: 10, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: true
        }
      }
    }

    stage('Docker build and tag') {
      steps {
        sh "docker build -t ${env.IMAGE_NAME} -f subscription/Dockerfile subscription"
      }
    }
  }
}
